# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/agri-clinic-hub-test

# JWT Secret (Generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMS Service (Optional - for production)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# AI Services
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=disease-embeddings
PINECONE_NAMESPACE=agri-clinic-namespace

# Cache (Redis)
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# External APIs
OPENWEATHER_API_KEY=your-openweather-api-key
AI_CV_SERVICE_URL=http://localhost:8000/predict
